{
  "name": "vanilla-p5-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "bun run --filter example-client dev",
    "dev:server": "bun run --filter example-server dev",
    "build:client": "bun run --filter example-client build",
    "test": "bun test packages/actor-sync/tests packages/lifecycles/tests packages/events/tests"
  }
}
